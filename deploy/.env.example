# Copy to deploy/.env and fill in. Never commit the real file.

# --- required -------------------------------------------------------------
# Your domain without https:// (for example: johannal.art)
SITE_DOMAIN=example.com
# Same domain with https://
SITE_URL=https://example.com
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# A long random string:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# --- email (orders, commissions, password resets) -------------------------
# Any SMTP provider works (Brevo, Resend, Zoho, Google Workspace ...).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Johanna L <hello@example.com>
# Where "new order / new message" alerts go (can also be set in the admin)
SHOP_NOTIFY_EMAIL=hello@example.com

# --- optional --------------------------------------------------------------
# Turn on once HTTPS works (31536000 = one year). Leave 0 until you are sure.
SECURE_HSTS_SECONDS=0
