# {$SITE_DOMAIN} comes from deploy/.env, e.g. johannal.art
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Public uploads (artwork photos). Private downloads are NOT served here.
	handle /media/* {
		root * /srv/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
